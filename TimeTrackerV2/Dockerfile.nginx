# Builds Angular before creating the nginx website image.
FROM node:22-alpine AS angular-build

# Uses this folder while Angular is being built.
WORKDIR /usr/src/app

# Lets Docker copy Angular's package.json whether or not its package-lock.json exists.
COPY Angular/package*.json ./
# Installs the packages Angular needs to build.
RUN npm install

# Copies the Angular project into Docker.
COPY Angular/ ./
# Builds the Angular files that nginx will show in the browser.
RUN npm run build

# Starts a separate nginx image after Angular is built.
FROM nginx:alpine

# Uses this file to tell nginx how to show the website and reach the API.
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Puts the finished Angular website files where nginx can serve them.
COPY --from=angular-build /usr/src/app/dist/TimeTrackerV2/browser /usr/share/nginx/html

EXPOSE 80

ENTRYPOINT [ "nginx" ]

CMD [ "-g", "daemon off;" ]